kav_cmd_status() {
    local_state=stopped
    if [ -f "$KAV_PID_FILE" ]; then
        old_pid=$(cat "$KAV_PID_FILE" 2> /dev/null || true)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2> /dev/null; then
            local_state="running (pid $old_pid)"
        fi
    fi
    printf 'daemon:  %s\n' "$local_state"
    printf 'version: %s\n' "$(cat "$KAV_DATA_HOME/VERSION" 2> /dev/null || printf 'unknown')"
    if kav_have sqlite3 && [ -f "$KAV_DB_FILE" ]; then
        stats=$(kav_db "$KAV_DB_FILE" 'SELECT count(*), count(DISTINCT command) FROM history;' 2> /dev/null || true)
        size=$(stat -c %s "$KAV_DB_FILE" 2> /dev/null || true)
        printf 'history: %s\n' "$stats" | awk -F'|' '{ printf "         %s rows, %s distinct commands\n", $1, $2 }'
        [ -n "$size" ] && printf 'db:      %.1f MB\n' "$(awk -v s="$size" 'BEGIN { printf "%.1f", s / 1048576 }')"
    else
        printf 'history: database not found at %s\n' "$KAV_DB_FILE"
    fi
    if [ -f "$KAV_RUNTIME_DIR/integrity_failed" ]; then
        printf 'WARNING: the database failed its integrity check at daemon boot —\n'
        printf '         restore a snapshot (see server.log for details) before relying on it\n'
    fi
}

kav_cmd_info() {
    printf 'data dir:   %s\n' "$KAV_DATA_HOME"
    printf 'database:   %s\n' "$KAV_DB_FILE"
    printf 'socket:     %s\n' "$KAV_SOCK_FILE"
    printf 'pid file:   %s\n' "$KAV_PID_FILE"
    printf 'log file:   %s\n' "$KAV_RUNTIME_DIR/server.log"
    printf 'version:    %s\n' "$(cat "$KAV_DATA_HOME/VERSION" 2> /dev/null || printf 'unknown')"
    if [ -f "$KAV_DATA_HOME/INSTALLED_REVISION" ]; then
        printf 'revision:   %s\n' "$(head -n 1 "$KAV_DATA_HOME/INSTALLED_REVISION")"
    fi
    hooks=""
    grep -qsE '^\s*source.*functions\.bash' "$HOME/.bashrc" 2> /dev/null && hooks="bash ✓$hooks"
    [ -n "$hooks" ] || hooks="bash —"
    grep -qsE '^\s*source.*functions\.zsh' "$HOME/.zshrc" 2> /dev/null && hooks="$hooks · zsh ✓" || hooks="$hooks · zsh —"
    grep -qsE '^\s*source.*functions\.fish' "$HOME/.config/fish/config.fish" 2> /dev/null && hooks="$hooks · fish ✓" || hooks="$hooks · fish —"
    printf 'hooks:      %s\n' "$hooks"
}

kav_cmd_import() {
    exec "$_SCRIPT_DIR/import.sh" "$@"
}

kav_cmd_update() {
    repo="${KAVKASH_REPO:-altunyurt/kavkash}"
    url="https://raw.githubusercontent.com/$repo/main/install.sh"
    current=$(cat "$KAV_DATA_HOME/VERSION" 2> /dev/null || printf unknown)
    kav_have curl || kav_die 'update: curl is required (or run the installer manually: see README)'
    # Short-circuit: installed version == latest release tag → nothing to
    # do. Falls through when the check fails (offline, bad repo) — the
    # installer fetch then reports the real error.
    latest=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" 2> /dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n 1)
    if [ -n "$latest" ]; then
        if [ "${latest#v}" = "$current" ]; then
            printf 'kavkash: already up to date (version %s)\n' "$current"
            exit 0
        fi
        printf 'kavkash: version %s installed, latest release is %s\n' "$current" "$latest"
    else
        printf 'kavkash: could not determine the latest release (network? repo?) — running the installer anyway\n'
    fi
    printf 'kavkash: fetching %s\n' "$url"
    tmp=$(mktemp "${TMPDIR:-/tmp}/kavkash-update.XXXXXX") || kav_die 'update: cannot create a temp file'
    if ! curl -fsSL "$url" -o "$tmp"; then
        rm -f "$tmp"
        kav_die "update: failed to fetch $url (network down? repo wrong?) — nothing changed"
    fi
    # The installer re-installs over KAV_DATA_HOME: overwrites the
    # scripts, offers the re-import, prints the restart note. Its exit
    # code passes through.
    dash "$tmp"
    rc=$?
    rm -f "$tmp"
    exit "$rc"
}

# WHEN (duration like 30d / 12h / 8w / 2mo / 45min / 1y, or a strict
# date) -> ns since epoch, matching the id timestamps (local time).
# Durations are "N <unit> ago" — always past. No bare "m": ambiguous
# between minutes and months (misreading 45m as months would prune
# nearly everything) — minutes are 45min, months 2mo. Dates are a STRICT
# whitelist; nothing else reaches GNU date, whose magic words can
# resolve to FUTURE times and make --older-than delete everything.
_kav_prune_when_ns() {
    when=$1
    [ -n "$when" ] || kav_die 'prune: empty WHEN — use e.g. 30d, 12h, 8w, 2mo, 45min, 1y or a date'
    num=""
    unit=""
    case "$when" in
        yesterday | today) : ;;   # date words — matched before the *y unit
        *min) num=${when%min}; unit=minutes ;;
        *mo)  num=${when%mo};  unit=months ;;
        *d)   num=${when%d};   unit=days ;;
        *h)   num=${when%h};   unit=hours ;;
        *w)   num=${when%w};   unit=weeks ;;
        *y)   num=${when%y};   unit=years ;;
    esac
    if [ -n "$unit" ]; then
        case "$num" in '' | *[!0-9]*) kav_die "prune: invalid duration: '$when' (use e.g. 30d, 12h, 8w, 2mo, 45min, 1y or a date)";; esac
        phrase="$num $unit ago"
        secs=$(date -d "$phrase" +%s 2> /dev/null) || kav_die "prune: cannot parse time: '$when'"
    else
        case "$when" in
            *[0-9]m) kav_die "prune: '$when' — 'm' alone is ambiguous: use 45min for minutes or 45mo for months" ;;
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9]) : ;;
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9]:[0-9][0-9]) : ;;
            yesterday | today) : ;;
            *) kav_die "prune: '$when' is not a recognized duration (30d, 12h, 8w, 2mo, 45min, 1y) or date (YYYY-MM-DD [HH:MM[:SS]], yesterday, today)" ;;
        esac
        secs=$(date -d "$when" +%s 2> /dev/null) || kav_die "prune: cannot parse time: '$when'"
        now=$(date +%s)
        [ "$secs" -le "$now" ] || kav_die "prune: boundary '$when' is in the future — refusing (use --newest=N to remove recent commands)"
    fi
    printf '%s000000000\n' "$secs"
}

kav_cmd_prune() {
    [ "$#" -gt 0 ] || { kav_help_prune >&2; exit 2; }
    mean_it=0
    conds=""
    what=""
    while [ "$#" -gt 0 ]; do
        arg=$1
        case "$arg" in
            --oldest=*)  n=${arg#--oldest=} ;;
            --oldest)    shift; n=$1 ;;
            --newest=*)  n=${arg#--newest=} ;;
            --newest)    shift; n=$1 ;;
            --older-than=*) when=${arg#--older-than=} ;;
            --older-than)   shift; when=$1 ;;
            --newer-than=*) when=${arg#--newer-than=} ;;
            --newer-than)   shift; when=$1 ;;
            --mean-it) mean_it=1 ;;
            *) kav_die "prune: unknown argument: $arg" ;;
        esac
        case "$arg" in
            --oldest*)
                case "$n" in '' | *[!0-9]*) kav_die "prune: --oldest must be a positive integer (got '$n')";; esac
                [ "$n" -gt 0 ] || kav_die 'prune: --oldest must be > 0'
                conds="${conds}${conds:+ OR }id IN (SELECT id FROM history ORDER BY id ASC LIMIT $n)"
                what="${what}${what:+, }oldest $n"
                ;;
            --newest*)
                case "$n" in '' | *[!0-9]*) kav_die "prune: --newest must be a positive integer (got '$n')";; esac
                [ "$n" -gt 0 ] || kav_die 'prune: --newest must be > 0'
                conds="${conds}${conds:+ OR }id IN (SELECT id FROM history ORDER BY id DESC LIMIT $n)"
                what="${what}${what:+, }newest $n"
                ;;
            --older-than*)
                ns=$(_kav_prune_when_ns "$when")
                conds="${conds}${conds:+ OR }id < $ns"
                what="${what}${what:+, }older than $when"
                ;;
            --newer-than*)
                ns=$(_kav_prune_when_ns "$when")
                conds="${conds}${conds:+ OR }id > $ns"
                what="${what}${what:+, }newer than $when"
                ;;
        esac
        shift
    done
    [ -n "$conds" ] || { kav_help_prune >&2; exit 2; }
    kav_have sqlite3 || kav_die 'prune: sqlite3 is required'
    [ -f "$KAV_DB_FILE" ] || kav_die "prune: no database at $KAV_DB_FILE"

    if [ "$mean_it" -eq 0 ]; then
        # Dry run by default: show what WOULD be removed, change nothing.
        would=$(kav_db "$KAV_DB_FILE" "SELECT count(*) FROM history WHERE $conds;")
        total=$(kav_db "$KAV_DB_FILE" 'SELECT count(*) FROM history;')
        printf 'dry run: would remove %s of %s rows (removed: %s)\n' "$would" "$total" "$what"
        printf '         nothing was changed — rerun with --mean-it to apply\n'
        return 0
    fi

    before=$(kav_db "$KAV_DB_FILE" 'SELECT count(*) FROM history;')
    kav_db "$KAV_DB_FILE" "DELETE FROM history WHERE $conds;"
    kav_db "$KAV_DB_FILE" 'VACUUM;'
    after=$(kav_db "$KAV_DB_FILE" 'SELECT count(*) FROM history;')
    printf 'pruned: %s -> %s rows (removed: %s)\n' "$before" "$after" "$what"
}

kav_cmd_compact() {
    kav_have sqlite3 || kav_die 'compact: sqlite3 is required'
    [ -f "$KAV_DB_FILE" ] || kav_die "compact: no database at $KAV_DB_FILE"
    check=$(kav_db "$KAV_DB_FILE" 'PRAGMA integrity_check;' 2> /dev/null || true)
    [ "$check" = ok ] || kav_die "compact: integrity check failed: $check"
    kav_db "$KAV_DB_FILE" 'VACUUM;'
    printf 'ok: integrity check passed, database vacuumed\n'
}

_kav_dedup_date_ok() {
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
        *) return 1 ;;
    esac
    [ "$(date -d "$1" +%F 2> /dev/null)" = "$1" ]
}

# WHEN (prune grammar: durations, yesterday/today, strict dates) -> the
# LOCAL DAY string YYYY-MM-DD. Dedup's --before/--after bounds are days,
# so durations/words collapse to their day (30d -> the day 30 days ago).
# No bare "m" (ambiguous between minutes and months): 45min / 2mo. The
# whitelist mirrors prune: nothing else reaches GNU date.
_kav_dedup_when_day() {
    when=$1
    [ -n "$when" ] || kav_die 'dedup: empty WHEN — use e.g. 30d, 12h, 8w, 2mo, 45min, 1y or a date'
    num=""
    unit=""
    case "$when" in
        yesterday | today) day=$(date -d "$when" +%F 2> /dev/null) || kav_die "dedup: cannot parse time: '$when'"
            printf '%s\n' "$day"; return 0 ;;
        *min) num=${when%min}; unit=minutes ;;
        *mo)  num=${when%mo};  unit=months ;;
        *d)   num=${when%d};   unit=days ;;
        *h)   num=${when%h};   unit=hours ;;
        *w)   num=${when%w};   unit=weeks ;;
        *y)   num=${when%y};   unit=years ;;
    esac
    if [ -n "$unit" ]; then
        case "$num" in '' | *[!0-9]*) kav_die "dedup: invalid duration: '$when' (use e.g. 30d, 12h, 8w, 2mo, 45min, 1y or a date)";; esac
        day=$(date -d "$num $unit ago" +%F 2> /dev/null) || kav_die "dedup: cannot parse time: '$when'"
        printf '%s\n' "$day"
    else
        case "$when" in
            *[0-9]m) kav_die "dedup: '$when' — 'm' alone is ambiguous: use 45min for minutes or 45mo for months" ;;
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9]) : ;;
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9]:[0-9][0-9]) : ;;
            *) kav_die "dedup: '$when' is not a recognized duration (30d, 12h, 8w, 2mo, 45min, 1y) or date (YYYY-MM-DD [HH:MM[:SS]], yesterday, today)" ;;
        esac
        day=$(date -d "$when" +%F 2> /dev/null) || kav_die "dedup: cannot parse time: '$when'"
        printf '%s\n' "$day"
    fi
}

kav_cmd_dedup() {
    mean_it=0
    all=0
    by_dir=""        # "" none · "key" bare (key += cwd) · "val" scoped to a cwd
    dir_vals=""      # | -separated cwd values for --by-dir=... (sep is char 31)
    by_date=""       # "" none · "key" (key += day) · "val" scoped to one day
    day_val=""
    before=""
    after=""
    sep=$(printf '\037')
    [ "$#" -gt 0 ] || { kav_help_dedup >&2; exit 2; }
    while [ "$#" -gt 0 ]; do
        arg=$1
        case "$arg" in
            --mean-it) mean_it=1 ;;
            --all)     all=1 ;;
            --by-dir)
                [ "$by_dir" = val ] && kav_die 'dedup: cannot combine --by-dir=VALUE with bare --by-dir'
                by_dir=key
                ;;
            --by-dir=*)
                [ "$by_dir" = key ] && kav_die 'dedup: cannot combine bare --by-dir with --by-dir=VALUE'
                by_dir=val
                v=${arg#--by-dir=}
                [ -n "$v" ] || kav_die 'dedup: empty --by-dir= (use --by-dir=/PATH)'
                dir_vals="${dir_vals}${dir_vals:+$sep}${v}"
                ;;
            --by-date)   by_date=key ;;
            --by-date=*)
                by_date=val
                day_val=${arg#--by-date=}
                _kav_dedup_date_ok "$day_val" || kav_die "dedup: --by-date must be a valid date YYYY-MM-DD (got '$day_val')"
                ;;
            --before=*)
                before=$(_kav_dedup_when_day "${arg#--before=}")
                ;;
            --after=*)
                after=$(_kav_dedup_when_day "${arg#--after=}")
                ;;
            *) kav_die "dedup: unknown argument: $arg" ;;
        esac
        shift
    done
    [ -n "$by_date" ] && { [ -n "$before" ] || [ -n "$after" ]; } \
        && kav_die 'dedup: --by-date cannot combine with --before/--after'
    if [ "$all" -eq 1 ]; then
        { [ -n "$by_dir" ] || [ -n "$by_date" ] || [ -n "$before" ] || [ -n "$after" ]; } \
            && kav_die 'dedup: --all cannot combine with --by-dir/--by-date/--before/--after'
    else
        { [ -n "$by_dir" ] || [ -n "$by_date" ] || [ -n "$before" ] || [ -n "$after" ]; } \
            || { kav_help_dedup >&2; exit 2; }
    fi
    kav_have sqlite3 || kav_die 'dedup: sqlite3 is required'
    [ -f "$KAV_DB_FILE" ] || kav_die "dedup: no database at $KAV_DB_FILE"

    dayexpr="strftime('%F', id/1000000000, 'unixepoch', 'localtime')"
    # dedup key: what "the same" means within the scope. The command is
    # rtrimmed (trailing whitespace folded) so "ls "/"ls<TAB>" merge
    # with "ls" — save-time (processor W) already trims new rows, this
    # converges pre-existing variants.
    key="rtrim(command, ' \t')"
    [ "$by_dir" = key ] && key="$key, cwd"
    [ "$by_date" = key ] && key="$key, $dayexpr"
    # scope: only matching rows are deduped; the rest are never touched
    scope=""
    scope_desc=""
    if [ "$by_dir" = val ]; then
        dir_conds=""
        dir_disp=""
        oldifs=$IFS; IFS=$sep
        for d in $dir_vals; do
            esc=$(printf '%s' "$d" | sed "s/'/''/g")
            dir_conds="${dir_conds}${dir_conds:+ OR }cwd = '$esc'"
            dir_disp="${dir_disp}${dir_disp:+, }$d"
        done
        IFS=$oldifs
        scope="${scope}${scope:+ AND }($dir_conds)"
        scope_desc="${scope_desc}${scope_desc:+; }cwd: $dir_disp"
    fi
    if [ "$by_date" = val ]; then
        esc=$(printf '%s' "$day_val" | sed "s/'/''/g")
        scope="${scope}${scope:+ AND }$dayexpr = '$esc'"
        scope_desc="${scope_desc}${scope_desc:+; }day: $day_val"
    fi
    if [ -n "$before" ]; then
        scope="${scope}${scope:+ AND }$dayexpr < '$before'"
        scope_desc="${scope_desc}${scope_desc:+; }before $before"
    fi
    if [ -n "$after" ]; then
        scope="${scope}${scope:+ AND }$dayexpr > '$after'"
        scope_desc="${scope_desc}${scope_desc:+; }after $after"
    fi

    where=""
    [ -n "$scope" ] && where="WHERE $scope"
    total=$(kav_db "$KAV_DB_FILE" "SELECT count(*) FROM history $where;")
    groups=$(kav_db "$KAV_DB_FILE" "SELECT count(*) FROM (SELECT 1 FROM history $where GROUP BY $key);")
    dup=$((total - groups))

    key_desc="command"
    [ "$by_dir" = key ] && key_desc="$key_desc, cwd"
    [ "$by_date" = key ] && key_desc="$key_desc, day"
    if [ "$mean_it" -eq 0 ]; then
        printf 'dry run: would remove %s of %s rows (%s groups by %s%s)\n' \
            "$dup" "$total" "$groups" "$key_desc" "${scope_desc:+; scope: $scope_desc}"
        printf '         nothing was changed — rerun with --mean-it to apply\n'
        return 0
    fi

    if [ -n "$scope" ]; then
        kav_db "$KAV_DB_FILE" "DELETE FROM history WHERE $scope AND id NOT IN (SELECT MAX(id) FROM history WHERE $scope GROUP BY $key);"
    else
        kav_db "$KAV_DB_FILE" "DELETE FROM history WHERE id NOT IN (SELECT MAX(id) FROM history GROUP BY $key);"
    fi
    # Normalize the surviving rows' command text: trailing whitespace was
    # folded into the key, so write the clean form back (in-scope rows
    # only — out-of-scope rows are never touched).
    if [ -n "$scope" ]; then
        kav_db "$KAV_DB_FILE" "UPDATE history SET command = rtrim(command, ' \t') WHERE $scope;"
    else
        kav_db "$KAV_DB_FILE" "UPDATE history SET command = rtrim(command, ' \t');"
    fi
    kav_db "$KAV_DB_FILE" 'VACUUM;'
    after_rows=$(kav_db "$KAV_DB_FILE" "SELECT count(*) FROM history $where;")
    printf 'deduped: %s -> %s rows in scope (kept the newest occurrence per %s%s)\n' \
        "$total" "$after_rows" "$key_desc" "${scope_desc:+; scope: $scope_desc}"
}

kav_cmd_stats() {
    kav_have sqlite3 || kav_die 'stats: sqlite3 is required'
    [ -f "$KAV_DB_FILE" ] || kav_die "stats: no database at $KAV_DB_FILE"
    kav_db "$KAV_DB_FILE" 'SELECT count(*) || " total rows, " || count(DISTINCT command) || " distinct commands" FROM history;'
    printf '\nmost used commands:\n'
    kav_db -separator '  ' "$KAV_DB_FILE" \
        'SELECT count(*) AS uses, command FROM history GROUP BY command ORDER BY uses DESC LIMIT 10;'
}

kav_cmd_log() {
    n="${1:-50}"
    case "$n" in '' | *[!0-9]*) n=50;; esac
    [ -f "$KAV_RUNTIME_DIR/server.log" ] || kav_die "log: no server.log yet at $KAV_RUNTIME_DIR/server.log"
    tail -n "$n" "$KAV_RUNTIME_DIR/server.log"
}

kav_cmd_restore() {
    file="${1:-}"
    [ -n "$file" ] || kav_die 'restore: usage: kavkash restore FILE'
    [ -f "$file" ] || kav_die "restore: no such file: $file"
    kav_have sqlite3 || kav_die 'restore: sqlite3 is required'
    if ! sqlite3 "$file" 'PRAGMA integrity_check;' 2> /dev/null | grep -q '^ok$'; then
        kav_die "restore: $file is not a valid sqlite database"
    fi

    # Stop the daemon (systemd unit if installed, else pid TERM + wait).
    if [ -f "$HOME/.config/systemd/user/kavkash.service" ] && kav_have systemctl; then
        systemctl --user stop kavkash.service > /dev/null 2>&1 || true
    fi
    if [ -f "$KAV_PID_FILE" ]; then
        old_pid=$(cat "$KAV_PID_FILE" 2> /dev/null || true)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2> /dev/null; then
            kill -TERM "$old_pid" 2> /dev/null || true
            i=0
            while [ $i -lt 50 ] && kill -0 "$old_pid" 2> /dev/null; do
                sleep 0.1
                i=$((i + 1))
            done
        fi
    fi

    # WAL mode: fold any pending WAL content into the old database and
    # drop the sidecars, so the pre-restore copy is complete and no stale
    # -wal/-shm can be applied to the restored file.
    kav_db "$KAV_DB_FILE" 'PRAGMA wal_checkpoint(TRUNCATE);' > /dev/null 2>&1 || true
    rm -f "$KAV_DB_FILE-wal" "$KAV_DB_FILE-shm" "$KAV_DB_FILE-journal"

    # Swap the database in; never destroy the only copy.
    if [ -f "$KAV_DB_FILE" ]; then
        mv -f "$KAV_DB_FILE" "$KAV_DB_FILE.pre-restore"
    fi
    cp "$file" "$KAV_DB_FILE"
    rm -f "$KAV_DB_FILE-wal" "$KAV_DB_FILE-shm" "$KAV_DB_FILE-journal"

    # Start the daemon again (systemd unit if installed, else background).
    if [ -f "$HOME/.config/systemd/user/kavkash.service" ] && kav_have systemctl; then
        systemctl --user start kavkash.service > /dev/null 2>&1 || true
    else
        "$_SCRIPT_DIR/server.sh" > /dev/null 2>&1 &
    fi
    printf 'restored: %s -> %s (previous database kept at %s.pre-restore)\n' \
        "$file" "$KAV_DB_FILE" "$KAV_DB_FILE"
}

# kavkash history — namespace for the history data operations.
kav_cmd_history() {
    sub="${1:-help}"
    [ "$#" -gt 0 ] && shift
    # nested --help: `history SUBCOMMAND --help` routes to the subcommand's
    # standard help block; the namespace's own help handles bare `history`.
    case " $* " in
        *" --help "* | *" -h "*)
            case "$sub" in
                prune|dedup|stats|compact|import)
                    kav_help_$sub
                    exit 0
                    ;;
            esac
            ;;
    esac
    case "$sub" in
        prune)   kav_cmd_prune "$@" ;;
        dedup)   kav_cmd_dedup "$@" ;;
        stats)   kav_cmd_stats ;;
        compact) kav_cmd_compact ;;
        import)  kav_cmd_import "$@" ;;
        help|-h|--help) kav_help_history ;;
        *) kav_help_history >&2; exit 2 ;;
    esac
}

cmd="${1:-help}"
# Guarded shift: with no args, a bare `shift` under set -e is a fatal
# error in dash even with `|| true` (empirically).
[ "$#" -gt 0 ] && shift
# `kavkash COMMAND --help` prints the command's standard help block
# (uniform template); any subcommand answers it. `history` delegates to
# its own dispatcher, which routes nested `history SUBCOMMAND --help`.
case " $* " in
    *" --help "* | *" -h "*)
        case "$cmd" in
            status|info|backup|restore|update|log|version)
                kav_help_$cmd
                exit 0
                ;;
            history)
                kav_cmd_history "$@"
                exit 0
                ;;
            help|-h|--help)
                usage
                exit 0
                ;;
        esac
        usage >&2
        exit 2
        ;;
esac
case "$cmd" in
    status)  kav_cmd_status ;;
    info)    kav_cmd_info ;;
    backup)  exec "$_SCRIPT_DIR/backup.sh" "$@" ;;
    restore) kav_cmd_restore "$@" ;;
    update)  kav_cmd_update ;;
    history) kav_cmd_history "$@" ;;
    log)     kav_cmd_log "$@" ;;
    version) cat "$KAV_DATA_HOME/VERSION" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac

#!/usr/bin/dash
# kavkash — user-facing command dispatcher (see docs/cli.md).
#
# One entry point for the ops commands, atuin/git-style. The internal
# scripts (hook.sh, processor.sh, query.sh, picker.sh, delete.sh,
# server.sh) stay invisible; this file is installed as
# ~/.local/bin/kavkash via a symlink (so realpath resolves the install
# dir regardless of the caller's CWD).
#
# Subcommands: status · info · backup [dir] · restore FILE · import ·
# prune [N] · compact · stats · log [N] · version · help

. "$(dirname -- "$(realpath -- "$0")")/includes.sh"
_SCRIPT_DIR=$(dirname -- "$(realpath -- "$0")")
set -eu

usage() {
    cat <<'EOF'
kavkash — shell history daemon, command-line interface

usage: kavkash COMMAND [ARGS]        per-command help: kavkash COMMAND --help

  status        daemon up? version, rows/distinct, db size
  info          install paths, version, revision, shell-hook status
  backup [DIR]  snapshot history.db (consistent, live-safe; keeps 7)
  restore FILE  replace history.db from a backup, restart the daemon
  update        update to the latest release (re-runs the installer)
  history       history data: prune · dedup · stats · compact · import
  log [N]       tail the daemon log (default 50 lines)
  version       print the installed version
  help          this help
EOF
}

# --- standard per-command help (kavkash COMMAND --help) -----------------
# Uniform template: title, usage, description, OPTIONS (where present),
# notes. Every subcommand answers --help with one of these blocks.

kav_help_history() {
    cat <<'EOF'
kavkash history — history data operations

usage: kavkash history SUBCOMMAND [ARGS]

Operations on the stored history data. Each subcommand answers
`kavkash history SUBCOMMAND --help` with its own flags.

SUBCOMMANDS:
  prune        remove history from the edges (dry run by default)
  dedup        collapse repeated commands to one row each (dry run by default)
  stats        totals + most-used commands
  compact      PRAGMA integrity_check, then VACUUM
  import       re-import shell/atuin history (idempotent)
EOF
}

kav_help_status() {
    cat <<'EOF'
kavkash status — daemon, version, and history overview

usage: kavkash status

Shows whether the daemon is running (pid), the installed version, the
history row count and distinct commands, and the database size.
EOF
}

kav_help_info() {
    cat <<'EOF'
kavkash info — install paths and state

usage: kavkash info

Prints the data dir, database, socket, pid file, and log file paths,
the installed version and revision, and which shell hooks are active
(rc files are scanned for the source lines).
EOF
}

kav_help_backup() {
    cat <<'EOF'
kavkash backup — snapshot history.db

usage: kavkash backup [DIR]

Takes a consistent snapshot of history.db via sqlite .backup (safe
while the daemon is writing) into DIR (default: the data dir), named
history.db.YYYY-MM-DD.HH-MM-SS (timestamped — consecutive runs never
overwrite). Keeps the newest 7 snapshots and prunes the
rest. Restore with `kavkash restore`.
EOF
}

kav_help_restore() {
    cat <<'EOF'
kavkash restore — replace history.db from a backup

usage: kavkash restore FILE

Stops the daemon, swaps FILE in as history.db (keeping the current
database as history.db.pre-restore), and restarts the daemon. FILE
must be a valid sqlite database.
EOF
}

kav_help_import() {
    cat <<'EOF'
kavkash history import — re-import shell/atuin history

usage: kavkash history import [ARGS]

Runs import.sh (idempotent — safe to re-run). Flags: -b/--bash,
-z/--zsh, -f/--fish, --atuin (requires the atuin CLI + key),
--all (everything; what install.sh passes).
EOF
}

kav_help_update() {
    cat <<'EOF'
kavkash update — update to the latest release

usage: kavkash update

Compares the installed version against the latest release tag on GitHub
(KAVKASH_REPO, default altunyurt/kavkash) and returns early — "already
up to date" — when they match. Otherwise fetches the installer and runs
it: the latest release is downloaded, checksum-verified, and installed
over this one. Offers a re-import.
EOF
}

kav_help_prune() {
    cat <<'EOF'
kavkash history prune — remove history from the edges

usage: kavkash history prune [OPTIONS] [--mean-it]

Removes history from the edges of the timeline; everything else stays.
Dry run by default: every flag is parsed and validated, what would be
removed is printed, and nothing changes — --mean-it applies it.

OPTIONS:
  --oldest=N          remove the N oldest commands
  --newest=N          remove the N newest commands
  --older-than=WHEN   remove everything older than WHEN
  --newer-than=WHEN   remove everything newer than WHEN
  --mean-it           apply the removal (dry run otherwise)

WHEN is a duration (30d, 12h, 8w, 2mo, 45min, 1y — no bare "m": 2mo
is months, 45min is minutes) or a strict date (YYYY-MM-DD,
YYYY-MM-DD HH:MM[:SS], yesterday, today). Durations are always "N unit
ago"; future boundaries are refused. Flags combine (removed spans
union); rows are vacuumed afterwards.
EOF
}

kav_help_dedup() {
    cat <<'EOF'
kavkash history dedup — collapse repeated commands to one row each

usage: kavkash history dedup (--all | OPTIONS) [--mean-it]

Collapses the stored table to one row per command (keeps the newest
occurrence per group). --all runs it over the whole table by command;
otherwise OPTIONS extend the dedup key or narrow the scope (rows
outside the scope are never touched). --all is mutually exclusive with
the filtering options. Dry run by default — --mean-it applies it. No
arguments prints this help.

OPTIONS:
  --all               dedup the whole table (one row per distinct command)
  --by-dir            key: also group by working directory
  --by-dir=/PATH      scope: only dedup commands whose cwd is /PATH
                      (repeatable: --by-dir=/a --by-dir=/b = either)
  --by-date           key: also group by calendar day (local time)
  --by-date=DAY       scope: only dedup commands on that day
  --before=WHEN       scope: only rows strictly before WHEN's day
  --after=WHEN        scope: only rows strictly after WHEN's day
  --mean-it           apply the dedup (dry run otherwise)

DAY is strict YYYY-MM-DD. WHEN takes the prune grammar (30d, 12h, 8w,
2mo, 45min, 1y, yesterday, today, YYYY-MM-DD [HH:MM[:SS]]) and
resolves to its local day. --before/--after are mutually exclusive
with --by-date; --by-dir=/PATH cannot combine with bare --by-dir.
Trailing whitespace on commands is folded ("ls " = "ls") — new saves
are trimmed by the daemon; dedup also normalizes surviving rows.
Rows are vacuumed afterwards.
EOF
}

kav_help_compact() {
    cat <<'EOF'
kavkash history compact — integrity check and vacuum

usage: kavkash history compact

Runs PRAGMA integrity_check (must pass) and then VACUUM to reclaim
space.
EOF
}

